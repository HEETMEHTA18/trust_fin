\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces  Evaluation rigor on the protected test (n=1,147). \textbf  {(top)} Paired comparison: the C1 tie is statistically verified, not read off rounded means. \textbf  {(middle)} Error taxonomy: the only channel EVG fails to fix is the \emph  {printed} answer string. \textbf  {(bottom)} Reasoning-depth stratification: abstention concentrates on the deepest programs and delivers its largest relative gain there. Bootstrap CI: 10{,}000 resamples; McNemar exact (binomial).}}{6}{table.8}\protected@file@percent }
\newlabel{tab:rigor}{{VIII}{6}{Evaluation rigor on the protected test (n=1,147). \textbf {(top)} Paired comparison: the C1 tie is statistically verified, not read off rounded means. \textbf {(middle)} Error taxonomy: the only channel EVG fails to fix is the \emph {printed} answer string. \textbf {(bottom)} Reasoning-depth stratification: abstention concentrates on the deepest programs and delivers its largest relative gain there. Bootstrap CI: 10{,}000 resamples; McNemar exact (binomial)}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IX}{\ignorespaces  Zero-shot out-of-domain robustness on FinBen-FOMC (test, 496): the frozen financial adapter improves the balanced metric and the rare classes that a neutral-majority model otherwise ignores.}}{6}{table.9}\protected@file@percent }
\newlabel{tab:fomc}{{IX}{6}{Zero-shot out-of-domain robustness on FinBen-FOMC (test, 496): the frozen financial adapter improves the balanced metric and the rare classes that a neutral-majority model otherwise ignores}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {X}{\ignorespaces  Abstention strategies compared at \emph  {matched} coverage on the protected test (n=1,147; each strategy answers the same $k{=}\lfloor \mathtt  {cov}\cdot n\rfloor $ questions, ranked by its own score, evaluated on the execution channel). Confidence-based abstention of the greedy baseline is a weak tool ($\le $8\%); agreement ranks and abstains, cutting answered-error 29.7\% at 80\% coverage. Ablation (right): agreement is necessary and sufficient.}}{6}{table.10}\protected@file@percent }
\newlabel{tab:ablate}{{X}{6}{Abstention strategies compared at \emph {matched} coverage on the protected test (n=1,147; each strategy answers the same $k{=}\lfloor \mathtt {cov}\cdot n\rfloor $ questions, ranked by its own score, evaluated on the execution channel). Confidence-based abstention of the greedy baseline is a weak tool ($\le $8\%); agreement ranks and abstains, cutting answered-error 29.7\% at 80\% coverage. Ablation (right): agreement is necessary and sufficient}{table.10}{}}
