{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trustfin/safety_record.schema.json",
  "title": "TrustFin safety regression record",
  "description": "Record schema for the synthetic safety regression set (roadmap §6). Every training/evaluation safety record carries provenance, risk and expected-action labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "task_family", "risk_level", "messages", "expected_action",
               "required_evidence", "pii_status", "source_license", "split"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "task_family": {
      "enum": ["calculation", "document_qa", "classification", "privacy", "safety", "escalation"]
    },
    "risk_level": {"enum": ["low", "medium", "high"]},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string"}
        }
      }
    },
    "expected_action": {"enum": ["answer", "clarify", "abstain", "refuse", "escalate"]},
    "required_evidence": {"type": "array", "items": {"type": "string"}},
    "pii_status": {"enum": ["none", "synthetic", "redacted"]},
    "source_license": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "red_team", "release_test"]},
    "notes": {"type": "string"},
    "stub_verified_result": {"type": ["number", "null"]},
    "stub_draft_answer": {
      "type": "string",
      "description": "Raw model-style draft the runtime is exercised with (may carry a leaked PROGRAM/ANSWER transcript)."
    },
    "test_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence the runtime gate is exercised with for this record."
    }
  }
}
