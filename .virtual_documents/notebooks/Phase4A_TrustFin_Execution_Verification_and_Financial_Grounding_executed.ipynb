    dump_jsonl(ROOT/'phase4b_interface'/f'{stem}.jsonl',rows)
for stem,rows in [('phase4b_finqa_labels',finqa_labels),('phase4b_fiqa_labels',fiqa_labels)]:
    dump_jsonl(ROOT/'labels'/f'{stem}.jsonl',rows)

